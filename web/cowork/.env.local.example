# Cowork Dashboard — variáveis opcionais.
#
# COWORK_DB_PATH: override do caminho para o SQLite. Default: ../../data/coworker.db
# relativo a web/cowork/ (resolve para data/coworker.db na raiz do projeto).
#
# PORT: porta do `next dev`. Default 3000.

# COWORK_DB_PATH=../../data/coworker.db
# PORT=3000
